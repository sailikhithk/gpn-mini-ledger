vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

Layer 1 - Core Ledger: {
  style.fill: "#0f3460"
  style.stroke: "#e94560"
  style.stroke-width: 3

  "ledger-core": {
    label: "ledger-core\nLedgerService - JournalEntry\nAccount - AuthorizationHold"
    style.fill: "#1a1a2e"
  }
  "audit-chain": {
    label: "audit-chain (planned)\nSHA-256 hash chain\nTamper-evident log"
    style.fill: "#1a1a2e"
    style.stroke-dash: 3
  }
}

Layer 2 - Edge Switch: {
  style.fill: "#16213e"
  style.stroke: "#e94560"
  style.stroke-width: 2

  "api-gateway": {
    label: "api-gateway\nRequest routing\nRate limiting"
    style.fill: "#1a1a2e"
  }
  "idempotency": {
    label: "idempotency (planned)\nRedis + Postgres\ntwo-layer"
    style.fill: "#1a1a2e"
    style.stroke-dash: 3
  }
  "orchestrator": {
    label: "orchestrator (planned)\nPaymentSaga\ncompensation"
    style.fill: "#1a1a2e"
    style.stroke-dash: 3
  }
  "fraud-degradation": {
    label: "fraud-degradation (planned)\nfail-safe (not fail-open)"
    style.fill: "#1a1a2e"
    style.stroke-dash: 3
  }
}

Layer 3 - Async Lane: {
  style.fill: "#16213e"
  style.stroke: "#e94560"
  style.stroke-width: 2

  "outbox": {
    label: "outbox\nSKIP LOCKED claim\nstale reclaim"
    style.fill: "#1a1a2e"
  }
  "reconciliation": {
    label: "reconciliation (planned)\nfingerprinted dedup"
    style.fill: "#1a1a2e"
    style.stroke-dash: 3
  }
  "webhook": {
    label: "webhook (planned)\nHMAC + replay protection"
    style.fill: "#1a1a2e"
    style.stroke-dash: 3
  }
}

Data Stores: {
  style.fill: transparent
  style.stroke-dash: 3

  Postgres: {shape: cylinder; label: "PostgreSQL 16"; style.fill: "#1a1a2e"}
  Redis: {shape: cylinder; label: "Redis 7"; style.fill: "#1a1a2e"}
  S3: {shape: cloud; label: "LocalStack S3"; style.fill: "#1a1a2e"}
}

"Layer 2 - Edge Switch"."api-gateway" -> "Layer 1 - Core Ledger"."ledger-core"
"Layer 2 - Edge Switch"."api-gateway" -> "Layer 2 - Edge Switch"."idempotency"
"Layer 1 - Core Ledger"."ledger-core" -> Data Stores.Postgres
"Layer 1 - Core Ledger"."ledger-core" -> "Layer 3 - Async Lane"."outbox"
"Layer 3 - Async Lane"."outbox" -> Data Stores.Postgres
"Layer 2 - Edge Switch"."idempotency" -> Data Stores.Redis
"Layer 2 - Edge Switch"."idempotency" -> Data Stores.Postgres
"Layer 1 - Core Ledger"."audit-chain" -> Data Stores.Postgres
"Layer 1 - Core Ledger"."audit-chain" -> Data Stores.S3
"Layer 2 - Edge Switch"."orchestrator" -> "Layer 1 - Core Ledger"."ledger-core"
"Layer 2 - Edge Switch"."orchestrator" -> "Layer 2 - Edge Switch"."fraud-degradation"
"Layer 3 - Async Lane"."outbox" -> "Layer 3 - Async Lane"."webhook"
"Layer 3 - Async Lane"."reconciliation" -> Data Stores.Postgres
