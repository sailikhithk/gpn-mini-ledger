vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

Start: {
  shape: oval
  label: "capture() called"
  style.fill: "#0f3460"
  style.stroke: "#e94560"
}

CheckIdem: {
  shape: diamond
  label: "Idempotency key\nseen before?"
  style.fill: "#1a1a2e"
  style.stroke: "#e94560"
}

ReturnExisting: {
  label: "Return cached result\n(exactly-once)"
  style.fill: "#0f3460"
  style.stroke: "#e94560"
}

BeginTx: {
  label: "BEGIN SERIALIZABLE"
  style.fill: "#16213e"
  style.stroke: "#e94560"
}

ReadAuth: {
  label: "SELECT auth_hold\nFOR UPDATE"
  style.fill: "#16213e"
  style.stroke: "#e94560"
}

CheckBudget: {
  shape: diamond
  label: "captured + amount\n<= authorized?"
  style.fill: "#1a1a2e"
  style.stroke: "#e94560"
}

Rollback: {
  label: "ROLLBACK"
  style.fill: "#16213e"
  style.stroke: "#e94560"
}

ExceedsError: {
  shape: parallelogram
  label: "throw\nCaptureExceedsAuthorizationException"
  style.fill: "#4a1a1a"
  style.stroke: "#e94560"
}

WriteEntry: {
  label: "INSERT journal_entry\n+ journal_lines\n+ outbox_event"
  style.fill: "#16213e"
  style.stroke: "#e94560"
}

Commit: {
  shape: diamond
  label: "COMMIT"
  style.fill: "#1a1a2e"
  style.stroke: "#e94560"
}

ReturnSuccess: {
  shape: oval
  label: "Return LedgerEntryResult"
  style.fill: "#0f3460"
  style.stroke: "#e94560"
}

Retry: {
  shape: diamond
  label: "attempts < maxRetries?"
  style.fill: "#1a1a2e"
  style.stroke: "#e94560"
}

Backoff: {
  label: "sleep backoffMs * 2^attempt\n(exponential)"
  style.fill: "#16213e"
  style.stroke: "#e94560"
}

Propagate: {
  shape: parallelogram
  label: "throw ConcurrencyFailureException\n(retried 10x, still contended)"
  style.fill: "#4a1a1a"
  style.stroke: "#e94560"
}

Start -> CheckIdem
CheckIdem -> ReturnExisting: yes
CheckIdem -> BeginTx: no
BeginTx -> ReadAuth
ReadAuth -> CheckBudget
CheckBudget -> Rollback: no
Rollback -> ExceedsError
CheckBudget -> WriteEntry: yes
WriteEntry -> Commit
Commit -> ReturnSuccess: "success (40001 not thrown)"
Commit -> Retry: "40001 serialization conflict"
Retry -> Backoff: yes
Backoff -> BeginTx
Retry -> Propagate: no
