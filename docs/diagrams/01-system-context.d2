vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

External Actors: {
  style.fill: transparent
  style.stroke-dash: 3

  Merchant: {
    shape: person
    style.fill: "#e8f5e9"
  }
  Cardholder: {
    shape: person
    style.fill: "#e8f5e9"
  }
  Interviewer: {
    shape: person
    label: "Capital One\nInterviewer"
    style.fill: "#fff3e0"
  }
}

GPN Mini Ledger: {
  style.fill: "#1a1a2e"
  style.stroke: "#e94560"
  style.stroke-width: 2

  Gateway: {
    label: "API Gateway\n(Edge Switch)"
    shape: rectangle
    style.fill: "#16213e"
    style.stroke: "#e94560"
  }
  Ledger: {
    label: "Ledger Core\n(CP - Strong Consistency)"
    shape: rectangle
    style.fill: "#0f3460"
    style.stroke: "#e94560"
    style.stroke-width: 3
  }
  Outbox: {
    label: "Outbox Worker\n(BASE - Eventual)"
    shape: rectangle
    style.fill: "#16213e"
    style.stroke: "#e94560"
  }
}

Local Infrastructure (Docker): {
  style.fill: transparent
  style.stroke-dash: 3

  Postgres: {
    label: "PostgreSQL 16\nSERIALIZABLE + Flyway"
    shape: cylinder
    style.fill: "#1a1a2e"
    style.stroke: "#e94560"
  }
  Redis: {
    label: "Redis 7\nIdempotency cache"
    shape: cylinder
    style.fill: "#1a1a2e"
    style.stroke: "#e94560"
  }
  LocalStack: {
    label: "LocalStack\nS3 - SQS - DynamoDB"
    shape: cloud
    style.fill: "#1a1a2e"
    style.stroke: "#e94560"
  }
}

Cardholder -> Merchant: payment
Merchant -> GPN Mini Ledger.Gateway: "authorize / capture / refund"
GPN Mini Ledger.Gateway -> GPN Mini Ledger.Ledger: ledger write
GPN Mini Ledger.Ledger -> GPN Mini Ledger.Outbox: publish event
GPN Mini Ledger.Ledger -> Postgres
GPN Mini Ledger.Gateway -> Redis
GPN Mini Ledger.Outbox -> Postgres
GPN Mini Ledger.Outbox -> LocalStack
Interviewer -> GPN Mini Ledger: "clone + verify"
